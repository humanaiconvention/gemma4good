  "primitives": {
    "row_fill_green": {
      "description": "Row fills with #34D399 at 0.18 fill-opacity, 0.90 stroke; metric value text crossfades from #FFFFFF to #34D399; PASS pill scales 0.9 → 1.0 with the fill.",
