      "easing": "easeOutCubic"
    },
    "text_typewriter": {
      "description": "Characters reveal at type_on_cps with a 1-frame cursor blink. Cursor disappears 200 ms after final character.",
      "default_cps": 35
    },
    "shape_pulse": {
      "description": "Shape scales 0.85 → 1.0 over 300 ms then 1.0 → 0.85 over 600 ms; fill opacity tracks scale.",
      "duration_seconds": 0.9
    }
