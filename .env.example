# gemma4good — environment variable reference
# Copy this file to .env and fill in your values. NEVER commit .env.
#
# ── Google / Kaggle ────────────────────────────────────────────────────────────

# Gemini API fallback (optional — only needed if USE_GEMINI_ADAPTER=true)
# Get one free at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── On-chain / Foundry ────────────────────────────────────────────────────────
#
# To deploy HAICAnchor to Sepolia (free testnet):
#
# Step 1 — Get a Sepolia RPC URL (free tier on any of these):
#   • Alchemy:  https://dashboard.alchemy.com/  (create app → Ethereum Sepolia)
#   • Infura:   https://app.infura.io/           (create project → Sepolia endpoint)
#   • Chainlist (public, rate-limited): https://chainlist.org/?search=sepolia
#
# Step 2 — Fund your deployer wallet (need ~0.01 ETH for gas):
#   • Alchemy Sepolia Faucet: https://sepoliafaucet.com/     (0.5 ETH/day, free)
#   • Infura Faucet:          https://www.infura.io/faucet/sepolia
#   • Chainlink Faucet:       https://faucets.chain.link/sepolia
#   • Ethereum Foundation:    https://faucet.quicknode.com/ethereum/sepolia
#   Note: Some faucets require a mainnet ETH balance ≥ 0.001 to prevent spam.
#
# Step 3 — Get a free Etherscan API key for contract verification:
#   • https://etherscan.io/register → My Account → API Keys → Add
#
# Step 4 — Deploy:
#   cd D:\gemma4good\onchain
#   forge script script/Deploy.s.sol --rpc-url sepolia --broadcast --verify
#
# Step 5 — Record the deployed address below (HAIC_ANCHOR_ADDRESS).
#   You can also use Holesky instead of Sepolia (similar setup, longer-lived testnet).

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
HOLESKY_RPC_URL=https://eth-holesky.g.alchemy.com/v2/YOUR_KEY_HERE

# Private key of the deployer wallet (hex, 0x-prefixed).
# SECURITY: This key controls deployed contracts. Use a dedicated throwaway wallet
# for testnets — never a wallet holding real ETH.
DEPLOYER_PRIVATE_KEY=0x...

# Deployed contract address (fill in after running forge script --broadcast).
# Used by AnchorClient in maestro_integration/maestro_client.py.
HAIC_ANCHOR_ADDRESS=0x...

# Etherscan API key — enables `--verify` flag to publish source code on deployment.
ETHERSCAN_API_KEY=

# ── Anvil (local EVM — no keys needed, use for dev/CI) ────────────────────────
# To run locally without any wallet or faucet:
#   cd D:\gemma4good && python onchain/live_roundtrip.py
# This starts a local Anvil node, deploys, and runs a full anchor+verify roundtrip.
# Results saved to: onchain/live_roundtrip_result.json
