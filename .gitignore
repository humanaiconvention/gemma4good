# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Local artifacts
*.log
.coverage
local_*
scratch_*
_kaggle_upload/
adapters/
results/
_local_state/
_local_notes/
_local_worktrees/

# Model weights — should be loaded from HF, not committed
*.safetensors
*.bin
*.gguf

# Foundry / Solidity build artifacts (onchain)
onchain/out/
onchain/cache/
onchain/lib/
onchain/broadcast/

# Video build artifacts — the final video lives on YouTube, not the repo.
# Storyboard SVGs and production docs (preflight, teleprompter, captions,
# build scripts) ARE tracked; large binary build outputs are not.
video/clips/
video/out/
video/out_smoketest/
video/out_smoketest2/
video/vo/
video/_intro_frames_tmp/
video/_archive/
video/audio_assets/
*.mp4
*.wav
*.mp3
*.aup3
